<!-- sections/ayum-accordion.liquid — AYUM copy of Kalles accordion.liquid (original left untouched) -->
{%- comment -%}
  AYUM FAQ (Figma 2001:446 desktop / 2001:911 mobile). Differences from the original:
  - Items are blocks/_ayum-accordion-item.liquid: the native Accordion item (same <hdt-accordion> /
    <details> behaviour and settings) plus optional mobile question and answer.
  - "FAQ items" settings (space between items, question / answer sizes) and a Custom CSS class; the
    original's fixed 10px item gap is replaced by those settings.
  - Styles in assets/dev1.css (.ayum-faq). Colours come only from the native colour scheme.
{%- endcomment -%}
{{ 'dev1.css' | asset_url | stylesheet_tag: media: 'all' }}
{% style %}
  {% render 'spacing-vars', box: section %}
  #shopify-section-{{ section.id }} .ayum-faq {
    --ayum-faq-gap: {{ section.settings.ayum_item_gap }}px;
    --ayum-faq-gap-mb: {{ section.settings.ayum_item_gap_mb }}px;
    --ayum-faq-q: {{ section.settings.ayum_question_size }}px;
    --ayum-faq-q-mb: {{ section.settings.ayum_question_size_mb }}px;
    --ayum-faq-a: {{ section.settings.ayum_answer_size }}px;
    --ayum-faq-a-mb: {{ section.settings.ayum_answer_size_mb }}px;
  }
{% endstyle %}
{%- liquid
  #Section layout
  assign sizes  = '(min-width: 1150px) ' | append: settings.page_width | append: 'px,(min-width: 750px) calc(100vw - 60px), calc(100vw - 30px)'

  case section.settings.section_layout 
    when 'container'
      assign parent = 'hdt-container'
      assign child  = 'hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
    when 'wrapper_container'
      assign parent = 'hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
      assign child  = 'hdt-container'
    when 'full_width'
      assign parent = 'hdt-container-full hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
      assign child  = ''
      assign sizes  = '100vw'
  endcase
-%}

<div id="{{ section.id }}" class="{{ parent }} ayum-faq{% if section.settings.custom_class != blank %} {{ section.settings.custom_class | strip | escape }}{% endif %} {% if section.settings.hdt_background_parallax %} hdt-animate--parallax-bg {% endif %} hdt-s-gradient hdt-section-spacing hdt-section-spacing-{{ section.id }}" {%- if section.settings.colors_by_section %} color-scheme="{{ section.settings.color_scheme }}" style="--background-opacity: {{ section.settings.background_opacity }};"{%- endif %}>
  <div class="{{ child }}">
    {%- if section.settings.section_background != blank -%}
      {% liquid
        assign image = section.settings.section_background
      %}
      {{ image | image_url: width: image.width | image_tag: width: image.width, height: image.height, sizes: sizes, widths: '200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600,1700,1800,1900,2000', loading: 'lazy', class: 'hdt-section-background hdt-absolute hdt-top-0 hdt-left-0 hdt-w-full hdt-h-full hdt-pe-none hdt-object-cover hdt-object-center' }}
    {%- endif -%}
    {% content_for "block", type: "section-heading", id: "accordion-heading" %}
    <div class="hdt-flex hdt-flex-col hdt-justify-between hdt-row-accordion hdt-accordion-style{{ section.settings.accordion_des }}">
      {% content_for "blocks" %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.accordion.name",
  "tag": "section",
  "class": "hdt-section hdt-accordion",
  "disabled_on": {
    "groups": [
      "*"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.general_options.label"
    },
    {
      "type": "select",
      "id": "accordion_des",
      "label": "t:sections.accordion.settings.accordion_des",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_layout.label"
    },
    {
      "type": "select",
      "id": "section_layout",
      "label": "t:sections.all.section_layout.width.label",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.section_layout.width.container"
        },
        {
          "value": "wrapper_container",
          "label": "t:sections.all.section_layout.width.wrapper_container"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.section_layout.width.full_width"
        }
      ],
      "default": "container"
    },
    {
      "type": "image_picker",
      "id": "section_background",
      "label": "t:sections.all.background.image"
    },
    {
      "type": "checkbox",
      "id": "hdt_background_parallax",
      "label": "Using parallax for background",
      "visible_if": "{{ section.settings.section_background != blank }}",
      "default": false
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "checkbox",
      "id": "colors_by_section",
      "label": "t:sections.all.colors.display_colors_by_section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "visible_if": "{{ section.settings.colors_by_section }}"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "t:sections.all.background.opacity",
      "default": 0,
      "visible_if": "{{ section.settings.colors_by_section }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_spacing"
    },
    {
      "type": "text",
      "id": "mg",
      "label": "Margin",
      "info": "Margin top, margin right, margin bottom, margin left. If you not use to blank",
      "default": ",,50px,",
      "placeholder": ",,50px,"
    },
    {
      "type": "text",
      "id": "mg_mb",
      "label": "Margin (Mobile)",
      "default": ",,30px,",
      "placeholder": ",,50px,",
      "visible_if": "{{ section.settings.mg != blank }}"
    },
    {
      "type": "text",
      "id": "pd",
      "label": "Padding",
      "info": "Padding top, padding right, padding bottom, padding left. If you not use to blank",
      "placeholder": "50px,,50px,"
    },
    {
      "type": "text",
      "id": "pd_mb",
      "label": "Padding (Mobile)",
      "placeholder": ",,50px,",
      "visible_if": "{{ section.settings.pd != blank }}"
    },
    {
      "type": "header",
      "content": "FAQ items",
      "info": "Colors come from the color scheme: card = Background 2, border = Line border, question = Text, answer = Text 2, plus / minus = Accent."
    },
    {
      "type": "range",
      "id": "ayum_item_gap",
      "label": "Space between items (desktop)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "ayum_item_gap_mb",
      "label": "Space between items (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "ayum_question_size",
      "label": "Question size (desktop)",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "range",
      "id": "ayum_question_size_mb",
      "label": "Question size (mobile)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "ayum_answer_size",
      "label": "Answer size (desktop)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "ayum_answer_size_mb",
      "label": "Answer size (mobile)",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "_ayum-accordion-item"
    }
  ],
  "presets": [
    {
      "name": "t:sections.accordion.name",
      "category": "t:sections_categories.05_section.name",
      "settings": {
        "accordion_des": "1",
        "section_layout": "wrapper_container",
        "colors_by_section": true,
        "background_opacity": 1,
        "mg": "",
        "mg_mb": "",
        "pd": "48px,,48px,",
        "pd_mb": "24px,,24px,",
        "ayum_item_gap": 12,
        "ayum_item_gap_mb": 8,
        "ayum_question_size": 19,
        "ayum_question_size_mb": 13,
        "ayum_answer_size": 15,
        "ayum_answer_size_mb": 12
      },
      "blocks": [
        {
          "type": "section-heading",
          "id": "accordion-heading",
          "static": true,
          "settings": {
            "design_heading": "1",
            "horizontal": false,
            "alignment": "center",
            "heading_gap": 0,
            "margin_bottom": 32
          },
          "blocks": [
            {
              "type": "_heading_section",
              "settings": {
                "heading": "أسئلة شائعة",
                "line_height": "",
                "heading_size": "h_custom",
                "text_color": "hdt-s-text",
                "font_size_heading_lg": 36,
                "font_size_heading": 21,
                "letter_spacing_heading": 0
              }
            }
          ]
        },
        {
          "type": "_ayum-accordion-item",
          "settings": {
            "open": true,
            "icon": "none",
            "title": "كم مدة الصلاحية بعد فتح العبوة؟",
            "content": "<p>يفضّل استهلاكه خلال 7 أيام من الفتح مع إغلاق الباكت جيداً — الرطوبة هي العدو الوحيد للقرمشة.</p>",
            "content_mobile": "<p>يفضّل استهلاكها خلال 7 أيام من الفتح مع إغلاق العبوة جيداً — الرطوبة هي العدو الوحيد للقرمشة.</p>"
          }
        },
        {
          "type": "_ayum-accordion-item",
          "settings": {
            "open": false,
            "icon": "none",
            "title": "هل الفواكه فيها سكر مضاف؟"
          }
        },
        {
          "type": "_ayum-accordion-item",
          "settings": {
            "open": false,
            "icon": "none",
            "title": "كم تستغرق مدة التوصيل داخل الكويت؟",
            "title_mobile": "كم مدة التوصيل داخل الكويت؟"
          }
        },
        {
          "type": "_ayum-accordion-item",
          "settings": {
            "open": false,
            "icon": "none",
            "title": "هل تشحنون خارج الكويت؟"
          }
        },
        {
          "type": "_ayum-accordion-item",
          "settings": {
            "open": false,
            "icon": "none",
            "title": "ما سياسة الإرجاع والاستبدال؟"
          }
        }
      ]
    }
  ]
}
{% endschema %}