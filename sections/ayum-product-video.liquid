<!-- sections/ayum-product-video.liquid — AYUM copy of Kalles product-video.liquid (original left untouched) -->
{%- comment -%}
  AYUM shoppable videos (Figma 2001:366 desktop / 2001:861 mobile). Display name kept as the native "Shoppable Video".
  Style "ayum" adds the AYUM card (blocks/_ayum-product-video.liquid), a centred mobile carousel with dimmed
  neighbours (native Embla options through the slider config + the native .is-selected class), click-to-play with
  exclusive playback (assets/ayum-shoppable-video.js) and the AYUM desktop progress bar (assets/ayum-slider-progress.js).
  Styles 1 and 2 keep the native behaviour. Colours: section colour scheme (Scheme 3 in the AYUM instance) for the
  background, heading, subtitle, card surface, labels and media overlays; AYUM settings only for roles the scheme
  cannot express. Styles: assets/dev2.css, scoped under .ayum-product-video.
{%- endcomment -%}
{%- liquid
  assign ayum = false
  if section.settings.style == 'ayum'
    assign ayum = true
  endif
-%}
{%- if ayum -%}
  {{ 'dev2.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ayum-shoppable-video.js' | asset_url }}" defer></script>
  {%- if section.settings.ayum_show_progress -%}
    <script src="{{ 'ayum-slider-progress.js' | asset_url }}" defer></script>
  {%- endif -%}
{%- endif -%}
{% style %}
  {%- if ayum -%}
    #shopify-section-{{ section.id }} .ayum-product-video {
      --ayum-primary: {{ section.settings.ayum_primary_color.rgb }};
      --ayum-on-primary: {{ section.settings.ayum_on_primary_color.rgb }};
      --ayum-card-border: {{ section.settings.ayum_card_border_color.rgb }};
      --ayum-price: {{ section.settings.ayum_price_color.rgb }};
      --ayum-views-text: {{ section.settings.ayum_views_text_color.rgb }};
      --ayum-pv-gap: {{ section.settings.ayum_gap }}px;
      --ayum-pv-gap-mb: {{ section.settings.ayum_gap_mb }}px;
      --ayum-subtitle-mb: {{ section.settings.ayum_subtitle_size_mobile | divided_by: 10.0 }}rem;
      --ayum-product-title-lines: {{ section.settings.ayum_product_title_lines | default: 1 }};
    }
  {%- endif -%}
  @media (min-width: 768px) and (max-width: 1149px){
    #{{ section.id }} .md\:hdt-height--fixed{
      --media-overlap-content-h: calc(var(--aspect-ratioapt-md, auto) * 0.75);
    }
  }
  @media(min-width:768px){
    #shopify-section-{{section.id}} .hdt-dots-outline .hdt-slider__dots {
    margin-top: var(--dots-distance) !important;
  }
  }
  @media(max-width:767px){
    #shopify-section-{{section.id}} .hdt-dots-outline .hdt-slider__dots {
    margin-top: calc(var(--dots-distance)/2.0) !important;
  }
  }
  {% render 'spacing-vars', box: section %}
{% endstyle %}
<div
  id="{{ section.id }}"
  class="hdt-s-inner hdt-section-spacing hdt-section-spacing-{{ section.id }} hdt-s-gradient{%- if section.settings.image_height == 'full' -%} hdt-fullscreen-desktop{%- endif %} hdt-style-{{ section.settings.style }}{% if ayum %} ayum-product-video{% endif %}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class | strip | escape }}{% endif %}"
  color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="hdt-container{%- if section.settings.full_width -%}-full{%- endif -%}" id="Video-{{ section.id }}">
    <div class="hdt-product-video__heading hdt-slider">
      {% content_for 'block', type: 'section-heading', id: 'product-video' %}
      {%- if section.settings.navUI and section.settings.nav_position == 'heading' -%}
        <div class="hdt-navigation hdt-navigation-heading hdt-position-{{ section.settings.nav_position }} hdt-visible-{{ section.settings.nav_visible }} hdt-style-{{ section.settings.nav_style }} hdt-shape-{{ section.settings.nav_shape }} hdt-size-{{ section.settings.nav_size }} hdt-hide-mobile-{{ section.settings.nav_hide_mobile }}">
          <button aria-controls="Slider-{{ section.id }}" class="hdt-slider__button hdt-slider__button--prev" type="button" disabled name="previous" aria-label="previous">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.57 5.92993L3.5 11.9999L9.57 18.0699" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M20.4999 12H3.66992" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>              
          </button>
          <button aria-controls="Slider-{{ section.id }}" class="hdt-slider__button hdt-slider__button--next" type="button" disabled name="next" aria-label="next">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14.4299 5.92993L20.4999 11.9999L14.4299 18.0699" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3.5 12H20.33" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              
          </button>
        </div>
      {%- endif -%}
    </div>
    {%- liquid
      assign slider_class = 'hdt-slides-' | append: section.settings.col_mb | append: ' hdt-slide-spacing-' | append: section.settings.space_items
      assign slider_extra = ''
      if ayum
        # Mobile (< 768px): one centred card with both neighbours peeking (Figma 2001:865). Native Embla options passed
        # through the slider config: centre alignment, no snap trimming, one card per swipe, and (with 3+ cards) the
        # second card active on load so a neighbour peeks on both sides as designed. Card width/gaps: dev2.css.
        assign slider_class = 'ayum-pv__slider hdt-slides-1'
        assign mobile_start = 0
        if section.blocks.size >= 3
          assign mobile_start = 1
        endif
        assign slider_extra = ', "breakpoints": { "(max-width: 767px)": { "align": "center", "containScroll": false, "slidesToScroll": 1, "startIndex": ' | append: mobile_start | append: ' } }'
      endif
    -%}
    <hdt-slider id="Slider-{{ section.id }}" class="hdt-slider hdt-relative lg:hdt-slides-{{ section.settings.col_dk }} md:hdt-slides-{{ section.settings.col_tb }} {{ slider_class }}" config='{ "id": "Slider-{{ section.id }}", "navUI": {% if ayum %}{{ section.settings.navUI }}{% else %}"{{ section.settings.navUI }}"{% endif %}, "dotUI": true, "loop": {{ section.settings.loop }}, "autoPlay": {{ section.settings.autoplay | times: 1000 }}, "pauseOnHover": {{ section.settings.pauseOnHover }}{{ slider_extra }} }'>
      <div class="hdt-slider__viewport hdt-relative">
        <div class="hdt-slider__container">
          {% content_for 'blocks' %}
        </div>
      </div>
      {%- if section.settings.navUI and section.settings.nav_position != 'heading' -%}
        <div class="hdt-navigation hdt-position-{{ section.settings.nav_position }} hdt-visible-{{ section.settings.nav_visible }} hdt-style-{{ section.settings.nav_style }} hdt-shape-{{ section.settings.nav_shape }} hdt-size-{{ section.settings.nav_size }} hdt-hide-mobile-{{ section.settings.nav_hide_mobile }}">
          <button aria-controls="Slider-{{ section.id }}" class="hdt-slider__button hdt-slider__button--prev" type="button" disabled name="previous" aria-label="previous">
            <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M5.5 11L0 5.5L5.5 0L6.47625 0.97625L1.9525 5.5L6.47625 10.0238L5.5 11Z" fill="currentColor"/></svg>
          </button>
          <button aria-controls="Slider-{{ section.id }}" class="hdt-slider__button hdt-slider__button--next" type="button" disabled name="next" aria-label="next">
            <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M1.5 11L7 5.5L1.5 0L0.52375 0.97625L5.0475 5.5L0.52375 10.0238L1.5 11Z" fill="currentColor"/></svg>
          </button>
        </div>
      {%- endif -%}
      {%- if section.settings.dotUI -%}
        <div hdt-slider-dots aria-controls="Slider-{{ section.id }}" class="hdt-slider__dots hdt-pagination hdt-style-{{ section.settings.pag_style }} hdt-radius-{{ section.settings.pag_rounded }}{% if section.settings.only_show_mobile %} hdt-only-show-mobile{% else %} hdt-hide-mobile-{{ section.settings.pag_hide_mobile }}{% endif %}" style="--space-between: {{ section.settings.pag_space }}px; --margin-top: {{ section.settings.pag_mgt }}px;" hdt-reveal="slide-in" timeline></div>
      {%- endif -%}
    </hdt-slider>
    {%- if ayum -%}
      {%- if section.settings.ayum_show_progress -%}
        {%- comment -%} Desktop progress (Figma 2001:444), driven by the native slider's Embla API; hidden below 768px. {%- endcomment -%}
        <ayum-slider-progress class="ayum-slider-progress" aria-controls="Slider-{{ section.id }}" aria-hidden="true">
          <span class="ayum-slider-progress__thumb"></span>
        </ayum-slider-progress>
      {%- endif -%}
      {%- comment -%} Click-to-play, exclusive playback, pause when a slide becomes inactive (assets/ayum-shoppable-video.js). {%- endcomment -%}
      <ayum-shoppable-video aria-controls="Slider-{{ section.id }}" hidden></ayum-shoppable-video>
    {%- endif -%}
  </div>
</div>
{% schema %}
