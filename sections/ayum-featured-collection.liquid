<!-- ayum-featured-collection.liquid — AYUM copy of Kalles featured-collection.liquid (original left untouched) -->
{%- comment -%}
  AYUM "Featured Bundles" (Figma 2001:156 desktop / 2001:721 mobile).
  Colours: the section colour scheme ("Display colors by section" + "Color scheme", Scheme 2 in the AYUM instance,
  background at "Background opacity") drives the background, heading, subheading, card surface, title, description,
  old price and badge background. Only roles no scheme variable can hold are AYUM settings (Figma values as defaults).
  Styles: assets/dev2.css, every rule scoped under .ayum-featured-collection.
{%- endcomment -%}
{{ 'dev2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ayum-slider-progress.js' | asset_url }}" defer></script>

{%- liquid
  #Section layout
  assign sizes  = '(min-width: 1150px) ' | append: settings.page_width | append: 'px,(min-width: 750px) calc(100vw - 60px), calc(100vw - 30px)'

  case section.settings.section_layout 
    when 'container'
      assign parent = 'hdt-container'
      assign child  = 'hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
    when 'wrapper_container'
      assign parent = 'hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
      assign child  = 'hdt-container'
    when 'full_width'
      assign parent = 'hdt-container-full hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
      assign child  = ''
      assign sizes  = '100vw'
  endcase
-%}
{% style %}
  {% render 'spacing-vars', box: section %}
  #section-{{ section.id }}.ayum-featured-collection {
    --ayum-primary: {{ section.settings.ayum_primary_color.rgb }};
    --ayum-on-primary: {{ section.settings.ayum_on_primary_color.rgb }};
    --ayum-card-border: {{ section.settings.ayum_card_border_color.rgb }};
    --ayum-sale: {{ section.settings.ayum_sale_color.rgb }};
  }
{% endstyle %}
<div id="section-{{ section.id }}" class="{{ parent }} ayum-featured-collection{% if section.settings.custom_class != blank %} {{ section.settings.custom_class | strip | escape }}{% endif %} {% if section.settings.hdt_background_parallax %} hdt-animate--parallax-bg {% endif %}" {%- if section.settings.colors_by_section %} color-scheme="{{ section.settings.color_scheme }}" style="--background-opacity: {{ section.settings.background_opacity }};"{%- endif %}>
  <div class="{{ child }}">
    {%- if section.settings.section_background != blank -%}
      {% liquid
        assign image = section.settings.section_background
      %}
      {{ image | image_url: width: image.width | image_tag: width: image.width, height: image.height, sizes: sizes, widths: '200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600,1700,1800,1900,2000', loading: 'lazy', class: 'hdt-section-background hdt-absolute hdt-top-0 hdt-left-0 hdt-w-full hdt-h-full hdt-pe-none hdt-object-cover hdt-object-center' }}
    {%- endif -%}
    <div class="hdt-container-heading">
      {%- content_for "block", type: "section-heading", id: "pr-heading" -%}
    </div>
    {%- content_for "blocks" -%}
  </div>
</div>
{% schema %}
{
  "name": "Featured Bundles",
  "tag": "section",
  "max_blocks": 1,
  "class": "hdt-section hdt-featured-collection ayum-featured-collection-section",
  "blocks": [
    {
      "type": "_ayum-bundle-product-carousel"
    },
    {
      "type": "_product-grid"
    },
    {
      "type": "_product-carousel"
    }
  ],
  "disabled_on": {
    "groups": [
      "*"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.section_layout.label"
    },
    {
      "type": "checkbox",
      "id": "colors_by_section",
      "label": "t:sections.all.colors.display_colors_by_section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "t:sections.all.background.opacity",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_layout",
      "label": "t:sections.all.section_layout.width.label",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.section_layout.width.container"
        },
        {
          "value": "wrapper_container",
          "label": "t:sections.all.section_layout.width.wrapper_container"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.section_layout.width.full_width"
        }
      ],
      "default": "container"
    },
    {
      "type": "image_picker",
      "id": "section_background",
      "label": "t:sections.all.background.image"
    },
    {
      "type": "checkbox",
      "id": "hdt_background_parallax",
      "label": "Using parallax for background",
      "visible_if": "{{ section.settings.section_background != blank }}",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_spacing"
    },
    {
      "type": "text",
      "id": "mg",
      "label": "Margin",
      "info": "Margin top, margin right, margin bottom, margin left. If you not use to blank",
      "default": ",,50px,",
      "placeholder": ",,50px,"
    },
    {
      "type": "text",
      "id": "mg_mb",
      "label": "Margin (Mobile)",
      "default": ",,30px,",
      "placeholder": ",,50px,",
      "visible_if": "{{ section.settings.mg != blank }}"
    },
    {
      "type": "text",
      "id": "pd",
      "label": "Padding",
      "info": "Padding top, padding right, padding bottom, padding left. If you not use to blank",
      "placeholder": "50px,,50px,"
    },
    {
      "type": "text",
      "id": "pd_mb",
      "label": "Padding (Mobile)",
      "placeholder": ",,50px,",
      "visible_if": "{{ section.settings.pd != blank }}"
    },
    {
      "type": "header",
      "content": "AYUM colors",
      "info": "Background, heading, subheading, card surface, title, description and old price follow the color scheme."
    },
    {
      "type": "color",
      "id": "ayum_primary_color",
      "label": "Primary (button, progress bar)",
      "default": "#26B3D0"
    },
    {
      "type": "color",
      "id": "ayum_on_primary_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "ayum_card_border_color",
      "label": "Product card border color",
      "default": "#D3E3E8"
    },
    {
      "type": "color",
      "id": "ayum_sale_color",
      "label": "Price and savings badge text",
      "default": "#EA3A79"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "presets": [
    {
      "name": "Featured Bundles",
      "category": "t:sections_categories.03_collections.name",
      "settings": {
        "colors_by_section": true,
        "color_scheme": "scheme-77e4ef58-56a9-4631-876a-12098ba7d57d",
        "background_opacity": 0.6,
        "section_layout": "wrapper_container",
        "mg": "",
        "pd": "48px,,48px,",
        "pd_mb": "24px,,24px,"
      },
      "blocks": [
        {
          "type": "_ayum-bundle-product-carousel",
          "settings": {
            "collection": "{{ closest.collection }}"
          }
        },
        {
          "type": "section-heading",
          "static": true,
          "id": "pr-heading",
          "settings": {
            "design_heading": "1",
            "horizontal": false,
            "alignment": "center",
            "heading_gap": 16,
            "margin_bottom": 32
          },
          "blocks": [
            {
              "type": "_heading_section",
              "settings": {
                "heading": "باكتات وتوزيعات",
                "line_height": "hdt-lh-1",
                "heading_size": "h_custom",
                "text_color": "hdt-s-text",
                "font_size_heading_lg": 36,
                "font_size_heading": 21
              }
            },
            {
              "type": "_sub_heading_section",
              "settings": {
                "text": "<p>جرّب أكثر من منتج بسعر أوفر — والأفضل للمناسبات</p>",
                "hidden_on_mobile": true,
                "text_size": "custom",
                "text_color": "hdt-text-secondary",
                "font_size_text_lg": 16,
                "font_size_text": 14
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}