<!-- sections/ayum-icon-box.liquid — AYUM copy of Kalles icon-box.liquid (original left untouched) -->
{%- comment -%}
  AYUM "How we freeze-dry" (Figma 2001:250 desktop / 2001:765 mobile). Differences from the original:
  - Items are blocks/_ayum-icon-box.liquid (the native Icon box block plus step number, mobile
    description, AYUM icon and icon background colour).
  - A pinned "Claims" block (blocks/_ayum-claims.liquid + _ayum-claim.liquid) between the heading and the items.
  - Colours come from the native colour scheme ("Display colors by section" + "Color scheme"; Color Scheme 2 on
    the homepage, with Background opacity 0 so the section sits on the white page): the
    original's heading / icon / description / box / border / hover colour pickers are not carried over,
    because the scheme holds those roles (SKILL §2.8). Their CSS variables are set from the scheme in
    assets/dev1.css (.ayum-icon-box).
  - "Step cards" settings (title / description sizes, corner radius, mobile padding), a 23px option for
    "Space horizontal items", and a Custom CSS class.
{%- endcomment -%}
{{ 'hdt-icon-box.css' | asset_url | stylesheet_tag }}
{{ 'dev1.css' | asset_url | stylesheet_tag: media: 'all' }}
{% liquid
  assign pd_mb_split = section.settings.ayum_padding_mb | remove: ' ' | split: ','
  assign pd_mb = pd_mb_split[0] | append: ' ' | append: pd_mb_split[1] | append: ' ' | append: pd_mb_split[2] | append: ' ' | append: pd_mb_split[3]
%}
{% style %}
    {% render 'spacing-vars', box: section %}
    #shopify-section-{{ section.id }} .ayum-icon-box {
      --ayum-ib-title: {{ section.settings.ayum_title_size }}px;
      --ayum-ib-title-mb: {{ section.settings.ayum_title_size_mb }}px;
      --ayum-ib-desc: {{ section.settings.ayum_desc_size }}px;
      --ayum-ib-desc-mb: {{ section.settings.ayum_desc_size_mb }}px;
      --ayum-ib-radius: {{ section.settings.ayum_radius }}px;
      --ayum-ib-radius-mb: {{ section.settings.ayum_radius_mb }}px;
      --ayum-ib-sub-mb: {{ section.settings.ayum_subheading_size_mb }}px;
      {%- if section.settings.ayum_subheading_color != blank %}
      --ayum-ib-sub-color: {{ section.settings.ayum_subheading_color.rgb }};
      {%- endif %}
      {%- if section.settings.ayum_padding_mb != blank %}
      --ayum-ib-pad-mb: {{ pd_mb }};
      {%- endif %}
      {%- if section.settings.ayum_card_surface == 'background2' or section.settings.ayum_card_opacity != 60 %}
      --ayum-ib-card: {% if section.settings.ayum_card_surface == 'background2' %}var(--color-background2){% else %}var(--color-background, var(--color-base-background)){% endif %};
      --ayum-ib-card-opacity: {{ section.settings.ayum_card_opacity | divided_by: 100.0 }};
      {%- endif %}
      {%- if section.settings.ayum_icon_size != 52 %}
      --ayum-ib-icon: {{ section.settings.ayum_icon_size }}px;
      {%- endif %}
      {%- if section.settings.ayum_icon_size_mb != 40 %}
      --ayum-ib-icon-mb: {{ section.settings.ayum_icon_size_mb }}px;
      {%- endif %}
    }
{% endstyle %}
{% liquid
  #Section layout
  assign sizes  = '(min-width: 1150px) ' | append: settings.page_width | append: 'px,(min-width: 750px) calc(100vw - 60px), calc(100vw - 30px)'

  case section.settings.section_layout 
    when 'container'
      assign parent = 'hdt-container'
      assign child  = 'hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
    when 'wrapper_container'
      assign parent = 'hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
      assign child  = 'hdt-container'
    when 'full_width'
      assign parent = 'hdt-container-full hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
      assign child  = ''
      assign sizes  = '100vw'
  endcase
%}
<div class="{{ parent }} ayum-icon-box{% if section.settings.ayum_subheading_color != blank %} ayum-icon-box--sub-color{% endif %}{% if section.settings.ayum_background_source == 'accent' %} ayum-icon-box--bg-accent{% endif %}{% if section.settings.ayum_layout_mb == 'stack' %} ayum-icon-box--stack-mb{% endif %}{% if section.settings.ayum_desc_color == 'text80' %} ayum-icon-box--desc-text80{% endif %}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class | strip | escape }}{% endif %} {% if section.settings.hdt_background_parallax %} hdt-animate--parallax-bg {% endif %}" {%- if section.settings.colors_by_section %} color-scheme="{{ section.settings.color_scheme }}" style="--background-opacity: {{ section.settings.background_opacity }};"{%- endif %}>
  <div class="{{ child }}">
    {%- if section.settings.section_background != blank -%}
      {% liquid
        assign image = section.settings.section_background
      %}
        {{ image | image_url: width: image.width | image_tag: width: image.width, height: image.height, sizes: sizes, widths: '200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600,1700,1800,1900,2000', loading: 'lazy', class: 'hdt-section-background hdt-absolute hdt-top-0 hdt-left-0 hdt-w-full hdt-h-full hdt-pe-none hdt-object-cover hdt-object-center' }}
    {%- endif -%}
    {% liquid
      assign pd_content_split = section.settings.padding | remove: ' ' | split: ','
      assign pd_content =  pd_content_split[0] | append: ' ' | append: pd_content_split[1] | append: ' ' | append: pd_content_split[2] | append: ' ' | append: pd_content_split[3]
    %}
    <div class="hdt-section-heading">
      {% content_for 'block', type: 'section-heading', id: 'icon-box' %}
    </div>
    {% content_for 'block', type: '_ayum-claims', id: 'claims' %}
    <div class="hdt-icon-box hdt-iconbox-border__{{ section.settings.enable_border }} hdt-iconbox-shadow__{{ section.settings.enable_box_shadow }}" style="--padding-content: {{ pd_content }};--spacing-horizontal:{{ section.settings.space_horizontal }}px;--spacing-vertical:{{ section.settings.space_vertical }}px;--spacing-horizontal-mb:{{ section.settings.space_horizontal_mb }}px;--spacing-vertical-mb:{{ section.settings.space_vertical_mb }}px;">
      {% if section.settings.layout == 'grid' %}
        <div class="hdt-row-grid hdt-prent hdt-grid-cols-{{ section.settings.col_mb }} md:hdt-grid-cols-{{ section.settings.col_tb }} lg:hdt-grid-cols-{{ section.settings.col_dk }}">
      {% else %}
        <hdt-slider id="Slider-{{ section.id }}" class="hdt-slider hdt-prent hdt-relative hdt-slide-spacing-x lg:hdt-slides-{{ section.settings.col_dk }} md:hdt-slides-{{ section.settings.col_tb }} hdt-slides-{{ section.settings.col_mb }}" config='{ "id": "Slider-{{ section.id }}", "navUI": {{ section.settings.navUI }}, "dotUI": true, "loop": {{ section.settings.loop }}, "autoPlay": {{ section.settings.autoplay | times: 1000 }}, "pauseOnHover": {{ section.settings.pauseOnHover }} }'>
          <div class="hdt-slider__viewport hdt-relative">
            <div class="hdt-slider__container">
      {% endif %}
      {% content_for 'blocks' %}
      {% if section.settings.layout == 'grid' %}
        </div>
      {% else %}
            </div>
          </div>
          {%- if section.settings.navUI -%}
            <div class="hdt-navigation hdt-position-{{ section.settings.nav_position }} hdt-visible-{{ section.settings.nav_visible }} hdt-style-{{ section.settings.nav_style }} hdt-shape-{{ section.settings.nav_shape }} hdt-size-{{ section.settings.nav_size }} hdt-hide-mobile-{{ section.settings.nav_hide_mobile }}">
              <button aria-controls="Slider-{{ section.id }}" class="hdt-slider__button hdt-slider__button--prev" type="button" disabled name="previous" aria-label="previous">
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M5.5 11L0 5.5L5.5 0L6.47625 0.97625L1.9525 5.5L6.47625 10.0238L5.5 11Z" fill="currentColor"/></svg>
              </button>
              <button aria-controls="Slider-{{ section.id }}" class="hdt-slider__button hdt-slider__button--next" type="button" disabled name="next" aria-label="next">
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M1.5 11L7 5.5L1.5 0L0.52375 0.97625L5.0475 5.5L0.52375 10.0238L1.5 11Z" fill="currentColor"/></svg>
              </button>
            </div>
          {%- endif -%}
          {%- if section.settings.dotUI -%}
            <div hdt-slider-dots aria-controls="Slider-{{ section.id }}" class="hdt-slider__dots hdt-pagination hdt-style-{{ section.settings.pag_style }} hdt-radius-{{ section.settings.pag_rounded }}{% if section.settings.only_show_mobile %} hdt-only-show-mobile{% else %} hdt-hide-mobile-{{ section.settings.pag_hide_mobile }}{% endif %}" style="--space-between: {{ section.settings.pag_space }}px; --margin-top: {{ section.settings.pag_mgt }}px;" hdt-reveal="slide-in" timeline></div>
          {%- endif -%}
        </hdt-slider>
      {% endif %}
    </div>
  </div>
</div>
