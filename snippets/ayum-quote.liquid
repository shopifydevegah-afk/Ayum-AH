{%- comment -%}
  AYUM review card (Figma 2001:325 desktop / 2001:833 mobile), adapted from snippets/quote_1.liquid.
  Order: rating stars → verified badge (optional) → heading (optional) → text → [image (optional) + author · position / product].
  Stars use the native rating_star snippet; colours come from the section (native card settings + AYUM settings).

  Accepts:
  - block: {Object} the _ayum-testimonial-item block (required)

  Usage:
  {%- render 'ayum-quote', block: block -%}
{%- endcomment -%}
<div class="hdt-quote-wrap ayum-quote">
  {%- if block.settings.rating >= 1 -%}
    <div class="ayum-quote__rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.rating, rating_max: 5 }}">
      {%- render 'rating_star', rating: block.settings.rating -%}
    </div>
  {%- endif -%}
  {%- if block.settings.ayum_verified -%}
    <span class="ayum-quote__verified">
      <span class="ayum-quote__verified-dot" aria-hidden="true"></span>
      {{- 'products.product.ayum_verified_purchase' | t -}}
    </span>
  {%- endif -%}
  {%- if block.settings.heading != blank -%}
    <h3 class="hdt-testimonial-heading ayum-quote__heading">{{ block.settings.heading | escape }}</h3>
  {%- endif -%}
  <div class="ayum-quote__text">{{ block.settings.content }}</div>
  <div class="ayum-quote__footer">
    {%- if block.settings.image_avata != blank -%}
      {{ block.settings.image_avata | image_url: width: 84, height: 84, crop: 'center' | image_tag: width: 42, height: 42, loading: 'lazy', alt: block.settings.title, class: 'ayum-quote__image' }}
    {%- endif -%}
    <div class="ayum-quote__meta">
      {%- if block.settings.title != blank -%}
        <div class="hdt-quote-author ayum-quote__author">
          {{- block.settings.title | escape -}}
          {%- if block.settings.pos != blank %} · {{ block.settings.pos | escape }}{% endif -%}
        </div>
      {%- endif -%}
      {%- if block.settings.ayum_product != blank -%}
        <div class="ayum-quote__product">{{ block.settings.ayum_product | escape }}</div>
      {%- endif -%}
    </div>
  </div>
</div>
