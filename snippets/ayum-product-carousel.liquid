{%- comment -%}
  Renders: the AYUM product carousel shared by blocks/_ayum-product-carousel.liquid (Best sellers tabs,
  card "ayum") and blocks/_ayum-bundle-product-carousel.liquid (Bundles, card "ayum_bundle").
  This is the body both blocks used to carry in full: a copy of Kalles blocks/_product-carousel.liquid
  (native cards 1-12, native <hdt-slider>, view-all button) plus the two AYUM card options and the
  optional <ayum-slider-progress> bar. Each block keeps its own type, schema and saved settings; the
  card option offered in each block schema decides which AYUM branch renders.
  Accepts:
  - block: the calling block (settings and id are read from it)
  - carousel_collection: block.settings.collection, resolved in the block so {{ closest.collection }}
    dynamic sources resolve in the block context exactly as before
  - carousel_class: extra wrapper class (ayum-product-carousel / ayum-bundle-carousel)
  - carousel_style: wrapper style string (each block's title-lines custom property)
  Usage: {%- render 'ayum-product-carousel', block: block, carousel_collection: block.settings.collection, carousel_class: 'ayum-product-carousel', carousel_style: style -%}
{%- endcomment -%}
{%- liquid
  assign current_width = settings.page_width | append: 'px'
  assign current_width_tb = '100vw'
  assign current_width_mb = '100vw'
  if  section.settings.section_layout == "full_width"
    if section.settings.boxed_fullwidth
      assign current_width = '100vw - 60px'
      assign current_width_tb = '100vw - 30px'
      assign current_width_mb = '100vw - 30px'
    else
      assign current_width = '100vw'
    endif
  endif
  if section.settings.space_items == "x"
    assign space_item = settings.spacing_grid_horizontal
    assign space_item_tb = settings.spacing_grid_horizontal | divided_by: 2
    assign space_item_mb = settings.spacing_grid_horizontal | divided_by: 2
  else
    assign space_item = section.settings.space_items
    assign space_item_tb = space_item | times: 0.666 | round
    assign space_item_mb = space_item | times: 0.333 | round
  endif

  assign color_list = 'products.theme_settings.color' | t | downcase | strip | replace: ' ,', ',' | replace: ', ', ',' | split: ',' | uniq
  assign size_list = 'products.theme_settings.size' | t | downcase | strip | replace: ' ,', ',' | replace: ', ', ',' | split: ',' | uniq 
-%}

{%- capture sizes -%}
  (min-width: 1150px) calc(({{ current_width }} -  ({{ space_item }}px * ( {{ section.settings.col_dk }} - 1 ))) * 1 / {{ section.settings.col_dk }}),(min-width: 768px) calc( ({{ current_width_tb }} - ({{ space_item_tb }}px * ( {{ section.settings.col_tb }} - 1 ))) * 1 / {{ section.settings.col_tb }}), calc( ({{ current_width_mb }} - ({{ space_item_mb }}px * ( {{ section.settings.col_mb }} - 1 ) )) * 1 / {{ section.settings.col_mb }})
{%- endcapture -%}
{%- if request.visual_preview_mode or block.settings.product_list == blank and carousel_collection == blank %}  
  <div class="hdt-product-carousel {{ carousel_class }}" style="{{ carousel_style }}">
    <hdt-slider id="Slider-{{ section.id }}" class="hdt-slide-center-{{ block.settings.hdt_slide_center }} hdt-collection-products hdt-slider__products hdt-collection-has-pr{{ block.settings.product_des }} hdt-pr-border_{{ block.settings.pr_border }} hdt-ratio--{{ block.settings.image_ratio }} {% unless block.settings.image_size %} hdt-ratio--contain{% endunless %} hdt-slider hdt-slider-parent hdt-slide-spacing-{{ block.settings.space_items }} hdt-relative {% if block.settings.navUI %}hdt-slider-has-nav{% endif %} {% if block.settings.dotUI %}hdt-slider-has-dots-dk{% endif %} lg:hdt-slides-{{ block.settings.col_dk | default: "auto" }} md:hdt-slides-{{ block.settings.col_tb | default: "auto" }} hdt-slides-{{ block.settings.col_mb | default: "auto" }}" config='{ "id": "Slider-{{ block.id }}", "navUI": {{ block.settings.navUI }}, "dotUI": true, "loop": {{ block.settings.loop }}, "autoPlay": {{ block.settings.autoplay | times: 1000 }}, "pauseOnHover": {{ block.settings.pauseOnHover }}{% if block.settings.hdt_slide_center %}, "containScroll": "trimSnaps", "align": "center"{% endif %} }'>
      <div class="hdt-slider__viewport hdt-relative">
        <div class="hdt-slider__container">
          {%- liquid 
            for i in (1..block.settings.products_count)
              capture current
              cycle 1, 2 , 3, 4
              endcapture
              assign placeholder_image = 'product-apparel-' | append: current
              render 'card-product-placeholder', image_ratio: block.settings.image_ratio, placeholder_image: placeholder_image, section_id: section.id, class: "hdt-slider__slide"
            endfor
          -%}
        </div>
      </div>
      {%- if block.settings.navUI -%}
        <div class="hdt-navigation hdt-position-{{ block.settings.nav_position }} hdt-visible-{{ block.settings.nav_visible }} hdt-style-{{ block.settings.nav_style }} hdt-shape-{{ block.settings.nav_shape }} hdt-size-{{ block.settings.nav_size }} hdt-hide-mobile-{{ block.settings.nav_hide_mobile }}">
          <button aria-controls="Slider-{{ block.id }}" class="hdt-slider__button hdt-slider__button--prev" type="button" disabled name="previous" aria-label="previous">
            <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M5.5 11L0 5.5L5.5 0L6.47625 0.97625L1.9525 5.5L6.47625 10.0238L5.5 11Z" fill="currentColor"/></svg>
          </button>
          <button aria-controls="Slider-{{ block.id }}" class="hdt-slider__button hdt-slider__button--next" type="button" disabled name="next" aria-label="next">
            <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M1.5 11L7 5.5L1.5 0L0.52375 0.97625L5.0475 5.5L0.52375 10.0238L1.5 11Z" fill="currentColor"/></svg>
          </button>
        </div>
      {%- endif -%}
      {%- if block.settings.dotUI -%}
        <div hdt-slider-dots aria-controls="Slider-{{ block.id }}" class="hdt-slider__dots hdt-pagination hdt-style-{{ block.settings.pag_style }} hdt-radius-{{ block.settings.pag_rounded }}{% if block.settings.only_show_mobile %} hdt-only-show-mobile{% else %} hdt-hide-mobile-{{ block.settings.pag_hide_mobile }}{% endif %}" style="--space-between: {{ block.settings.pag_space }}px; --margin-top: {{ block.settings.pag_mgt }}px;" hdt-reveal="slide-in" timeline></div>
      {%- endif -%}
    </hdt-slider>
  </div>
{%- else -%}
  {%- if block.settings.product_list != blank %}
    {%- paginate block.settings.product_list by block.settings.products_count -%}
      <div class="hdt-product-carousel {{ carousel_class }}" style="{{ carousel_style }}">
        <hdt-slider id="Slider-{{ block.id }}" class="hdt-opacity-out-container-{{ block.settings.hdt_opacity_out_container }} hdt-slider-center-{{ block.settings.hdt_slide_center }} hdt-collection-products hdt-slider__products hdt-collection-has-pr{{ block.settings.product_des }} hdt-pr-border_{{ block.settings.pr_border }} hdt-ratio--{{ block.settings.image_ratio }} {% unless block.settings.image_size %} hdt-ratio--contain{% endunless %} hdt-slider hdt-slider-parent hdt-slide-spacing-{{ block.settings.space_items }} hdt-relative {% if block.settings.navUI %}hdt-slider-has-nav{% endif %} {% if block.settings.dotUI %}hdt-slider-has-dots-dk{% endif %} lg:hdt-slides-{{ block.settings.col_dk | default: "auto" }} md:hdt-slides-{{ block.settings.col_tb | default: "auto" }} hdt-slides-{{ block.settings.col_mb | default: "auto" }}"  config='{ "id": "Slider-{{ block.id }}", "navUI": {{ block.settings.navUI }}, "dotUI": true, "loop": {{ block.settings.loop }}, "autoPlay": {{ block.settings.autoplay | times: 1000 }}, "pauseOnHover": {{ block.settings.pauseOnHover }}, "navUICenter": true{% if block.settings.hdt_slide_center %}, "containScroll": "trimSnaps", "align": "center"{% endif %} }'>
          <div class="hdt-slider__viewport hdt-relative">
            <div class="hdt-slider__container">
              {%- liquid 
                if block.settings.product_list != blank
                  case block.settings.product_des
                    when '1'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'right'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product1', card_product: product, class: "hdt-slider__slide hdt-pr-style1", section_id: section.id, sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '2'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'top'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product2', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style2", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '3'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'left'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product3', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style3", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '4'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'top'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product4', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style4", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '5'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'left'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product5', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style5", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '6'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'left'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product6', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style6", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '7'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'left'
                        endif
                      endcapture
