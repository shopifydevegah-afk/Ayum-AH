            <span class="ayum-slider-progress__thumb"></span>
          </ayum-slider-progress>
        {%- endif -%}
        {%- if block.settings.pagination and paginate.next -%}
          <div class="hdt-pagination-wrapper hdt-prs-footer hdt-pagination-view_all hdt-flex hdt-justify-{{ block.settings.paginate_pos }}" timeline hdt-reveal="slide-in"  style="--pagination-distance:{{ block.settings.dis_pagination }}px;">
            <a id="btn-view-all-{{ block.id }}" class="hdt-view-all-btn hdt-btn hdt-oh hdt-inline-flex hdt-align-center hdt-justify-center hdt-relative {{ block.settings.btn_style }} hdt-btn--size-{{ block.settings.size }} hdt-font-{{ block.settings.btn_fw }}" href="{{ carousel_collection.url | default: routes.all_products_collection_url }}" hdt-reveal="slide-in" timeline>
