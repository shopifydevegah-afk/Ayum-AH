                        render 'card-product7', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style7", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '8'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'left'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product8', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style8", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '9'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'right'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product9', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style9", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '10'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'right'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product10', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style10", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '11'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'left'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product11', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style11", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when '12'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'top'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product12', card_product: product, section_id: section.id, class: "hdt-slider__slide hdt-pr-style2 hdt-pr-style12", sizes: sizes, image_ratio: block.settings.image_ratio, color_list: color_list, size_list: size_list, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor
                      endfor
                    when 'ayum'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'left'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product-ayum', card_product: product, class: "hdt-slider__slide hdt-pr-style7", section_id: section.id, sizes: sizes, image_ratio: block.settings.image_ratio, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor, show_tag: block.settings.ayum_show_tag, tag_prefix: block.settings.ayum_tag_prefix
                      endfor
                    when 'ayum_bundle'
                      capture btn_wishlist_code
                        if settings.wishlist_mode != '0'
                          render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'left'
                        endif
                      endcapture
                      for product in block.settings.product_list
                        render 'card-product-ayum-bundle', card_product: product, class: "hdt-slider__slide hdt-pr-style7", section_id: section.id, sizes: sizes, image_ratio: block.settings.image_ratio, btn_wishlist_code: btn_wishlist_code, show_vendor: block.settings.show_vendor, show_excerpt: block.settings.ayum_show_description, excerpt_length: block.settings.ayum_description_length, add_label: block.settings.ayum_atc_label
                      endfor
                  endcase
                else
                  for i in (1..block.settings.products_count)
                    capture current
                    cycle 1, 2 , 3, 4
                    endcapture
                    assign placeholder_image = 'product-apparel-' | append: current
                    render 'card-product-placeholder', image_ratio: block.settings.image_ratio, placeholder_image: placeholder_image, section_id: section.id, class: "hdt-slider__slide"
                  endfor
