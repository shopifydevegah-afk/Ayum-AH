{%- comment -%}
  AYUM nutrition button + popup (Figma 2048:1678 / 2048:2117 button, 1:2745 / 1:3067 modal).
  Rendered by blocks/_product-medias.liquid next to the thumbnails when the block setting
  "Nutrition button label" is filled; nothing renders otherwise.
  Native pieces reused: the <hdt-modal> / <dialog> pattern (global aria-controls toggle: focus, Escape,
  scroll lock), <hdt-tab> for the two tabs ([tab-item] / [tab-selected]; inactive panels are display:none),
  and the product's own form for "Add to cart" (a submit button with form="…" — the native product-form
  handler adds the selected variant). <ayum-tabs> (assets/custom.js) only keeps the ARIA tab state
  (aria-selected / tabindex) in sync with the native tab and adds arrow-key navigation.

  Data (per product first, then the block's editable fallbacks):
  - product.metafields.ayum.nutrition_table   multi-line text, one row per line: "العنصر | لكل 100 جم | لكل العبوة"
  - product.metafields.ayum.nutrition_serving single-line text, appended to the third column title, e.g. "(20 جم)"
  - product.metafields.ayum.ingredients       multi-line or rich text
  - product.metafields.ayum.nutrition_points  multi-line text, one point per line: "العنوان | الوصف"
  No nutrition value is invented: without product data the block's placeholder rows ("[  ]") are shown.

  Accepts:
  - product: {Object}
  - block: {Object} the _product-medias block (settings)
  - product_form_id: {String} id of the main product form
  - selected_variant: {Object}
{%- endcomment -%}
{%- liquid
  assign modal_id = 'ayum-nutrition-' | append: block.id
  assign rows_src = product.metafields.ayum.nutrition_table.value | default: block.settings.ayum_nutrition_rows
  assign rows = rows_src | strip | newline_to_br | split: '<br />'
  assign points_src = product.metafields.ayum.nutrition_points.value | default: block.settings.ayum_nutrition_points
  assign points = points_src | strip | newline_to_br | split: '<br />'
  assign ingredients = product.metafields.ayum.ingredients | metafield_tag
  if product.metafields.ayum.ingredients == blank
    assign ingredients = block.settings.ayum_nutrition_ingredients
  endif
  assign serving = product.metafields.ayum.nutrition_serving.value | strip
  assign popup_title = block.settings.ayum_nutrition_title | default: product.title
  assign tab_nutrition = block.settings.ayum_nutrition_tab_nutrition | default: block.settings.ayum_nutrition_label
  assign tab_ingredients = block.settings.ayum_nutrition_tab_ingredients
  assign show_ingredients = false
  if tab_ingredients != blank
    assign show_ingredients = true
  endif
-%}
<button type="button" class="ayum-nutrition-btn" aria-controls="{{ modal_id }}" aria-haspopup="dialog">{{ block.settings.ayum_nutrition_label | escape }}</button>
<hdt-modal class="hdt-modal hdt-product__modal ayum-nutrition-modal hdt-contents" color-scheme="{% if section.settings.colors_by_section and section.settings.color_scheme != blank %}{{ section.settings.color_scheme }}{% else %}{{ settings.color_scheme_dialog }}{% endif %}">
  <dialog id="{{ modal_id }}" class="hdt-dialog hdt-dialog-modal ayum-nutrition" scroll-lock aria-labelledby="{{ modal_id }}-title">
    <div class="hdt-dialog-modal__header ayum-nutrition__header">
      <h2 id="{{ modal_id }}-title" class="ayum-nutrition__title">{{ popup_title | escape }}</h2>
      <button ref="closeButton" class="hdt-s-text hdt-dialog-btn__close ayum-nutrition__close" aria-controls="{{ modal_id }}" aria-label="{{ 'accessibility.close' | t | escape }}">{%- render 'icon' with 'close' -%}</button>
    </div>
    <ayum-tabs class="ayum-nutrition__tabs-wrap">
      <hdt-tab class="ayum-nutrition__tabs" aria-controls="{{ modal_id }}-panels" role="tablist">
        <button type="button" role="tab" id="{{ modal_id }}-tab-1" aria-controls="{{ modal_id }}-panel-1" aria-selected="true" aria-current="true" class="ayum-nutrition__tab">{{ tab_nutrition | escape }}</button>
        {%- if show_ingredients -%}
          <button type="button" role="tab" id="{{ modal_id }}-tab-2" aria-controls="{{ modal_id }}-panel-2" aria-selected="false" aria-current="false" tabindex="-1" class="ayum-nutrition__tab">{{ tab_ingredients | escape }}</button>
        {%- endif -%}
      </hdt-tab>
    </ayum-tabs>
    <div id="{{ modal_id }}-panels" class="hdt-dialog-modal__inner hdt-current-scrollbar ayum-nutrition__body">
      <div tab-item tab-selected id="{{ modal_id }}-panel-1" role="tabpanel" aria-labelledby="{{ modal_id }}-tab-1" class="ayum-nutrition__panel">
        {%- if rows.size > 0 -%}
          <table class="ayum-nutrition__table">
            <thead>
              <tr>
                <th scope="col">{{ block.settings.ayum_nutrition_col_item | escape }}</th>
                <th scope="col">{{ block.settings.ayum_nutrition_col_100 | escape }}</th>
                <th scope="col">{{ block.settings.ayum_nutrition_col_pack | escape }}{% if serving != blank %} {{ serving | escape }}{% endif %}</th>
              </tr>
            </thead>
            <tbody>
              {%- for row in rows -%}
                {%- assign cells = row | strip | split: '|' -%}
                {%- if cells.size > 0 and cells[0] != blank -%}
                  <tr>
                    <th scope="row">{{ cells[0] | strip | escape }}</th>
                    <td>{{ cells[1] | strip | escape }}</td>
                    <td>{{ cells[2] | strip | escape }}</td>
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        {%- endif -%}
        {%- if points.size > 0 and points_src != blank -%}
          <ul class="ayum-nutrition__points">
            {%- for point in points -%}
              {%- assign parts = point | strip | split: '|' -%}
              {%- if parts.size > 0 and parts[0] != blank -%}
                <li><strong>{{ parts[0] | strip | escape }}</strong>{% if parts[1] != blank %}<span>{{ parts[1] | strip | escape }}</span>{% endif %}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if show_ingredients -%}
        <div tab-item id="{{ modal_id }}-panel-2" role="tabpanel" aria-labelledby="{{ modal_id }}-tab-2" class="ayum-nutrition__panel ayum-nutrition__ingredients">
          {%- if block.settings.ayum_nutrition_ingredients_heading != blank -%}
            <h3 class="ayum-nutrition__subtitle">{{ block.settings.ayum_nutrition_ingredients_heading | escape }}</h3>
          {%- endif -%}
          {%- if ingredients != blank -%}
            <div class="hdt-rte">{{ ingredients }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="ayum-nutrition__footer">
      <button type="submit" name="add" form="{{ product_form_id }}" class="ayum-nutrition__atc" aria-controls="{{ modal_id }}"{% unless selected_variant.available %} disabled{% endunless %}>
        {%- if selected_variant.available -%}
          {%- if block.settings.ayum_nutrition_atc_label != blank -%}{{ block.settings.ayum_nutrition_atc_label | escape }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
        {%- else -%}
          {{- 'products.product.sold_out' | t -}}
        {%- endif -%}
      </button>
      {%- if block.settings.ayum_nutrition_note != blank -%}
        <p class="ayum-nutrition__note">{{ block.settings.ayum_nutrition_note | escape }}</p>
      {%- endif -%}
    </div>
  </dialog>
</hdt-modal>
