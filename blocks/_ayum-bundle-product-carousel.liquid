<!-- _ayum-bundle-product-carousel.liquid — AYUM copy of Kalles _product-carousel.liquid (original left untouched) -->
{%- comment -%}
  Used by sections/ayum-featured-collection.liquid ("Featured Coll. — Bundles", Figma 2001:156 / 2001:721).
  Differences from the native block:
  - product card option "ayum_bundle" (snippets/card-product-ayum-bundle.liquid) in this block's own dispatcher;
    native cards 1-12 are unchanged;
  - optional desktop slider progress bar (<ayum-slider-progress>, shared assets/ayum-slider-progress.js);
  - AYUM bundle card settings (short description, add-to-cart label) at the end of the schema.
  The markup lives in snippets/ayum-product-carousel.liquid, shared with blocks/_ayum-product-carousel.liquid.
{%- endcomment -%}
{%- capture ayum_carousel_style -%}--ayum-product-title-lines: {{ block.settings.ayum_product_title_lines | default: 1 }};{%- endcapture -%}
{%- render 'ayum-product-carousel', block: block, carousel_collection: block.settings.collection, carousel_class: 'ayum-bundle-carousel', carousel_style: ayum_carousel_style -%}
