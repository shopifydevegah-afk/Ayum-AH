{%- liquid
  assign target = product
  assign product = section.settings.product | default: target
-%}
<style>
  .hdt-product__complimentary:has(.hdt-product__complimentary-list:empty){
    display: none;
  }
</style>
{%- unless product == blank and product.metafields.shopify--discovery--product_recommendation.complementary_products.value == blank -%}
  <div class="hdt-product-info__item hdt-product__price hdt-product__complimentary" {{ block.shopify_attributes }}>
    <div class="hdt-product-info__item hdt-product__complimentary">
      <div class="hdt-product__complimentary-wrap">
        <h3 class="hdt-text-lg hdt-font-semibold">{{ block.settings.text }}</h3>
        {%- comment -%} AYUM options (all off by default): maximum shown, compact rows, button label. {%- endcomment -%}
        {%- assign ayum_max = block.settings.ayum_max_items | default: 0 -%}
        <ul class="hdt-product__complimentary-list hdt-ratio--adapt_image{% if block.settings.ayum_compact %} ayum-upsell-compact{% endif %}">
        {%- for product in product.metafields.shopify--discovery--product_recommendation.complementary_products.value -%}
          {%- if ayum_max > 0 and forloop.index > ayum_max -%}{%- break -%}{%- endif -%}
          <li class="hdt-product__complimentary-item">
            {%- render 'pr_loop_item', section_id: block.id, product: product, sizes: "84px", widths: "84, 100, 180, 200", add_label: block.settings.ayum_btn_label -%}
          </li>
        {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endunless -%}
{% schema %}
{
  "name": "t:sections.main-product.blocks.complimentary_products.name",
  "tag": null,
  "settings":[
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:sections.main-product.blocks.complimentary_products.settings.text.label",
      "default": "Pairs well with"
    },
    {
      "type": "checkbox",
      "id": "show_ultra_btn",
      "label": "Show button add to cart",
      "default": false
    },
    {
      "type": "header",
      "content": "AYUM"
    },
    {
      "type": "range",
      "id": "ayum_max_items",
      "label": "Maximum products shown",
      "info": "0 shows every complementary product.",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "ayum_compact",
      "label": "Compact rows",
      "info": "Image, name and price in one row with the button beside them.",
      "default": false
    },
    {
      "type": "text",
      "id": "ayum_btn_label",
      "label": "Button label",
      "info": "Optional. Leave empty for the theme's add to cart text."
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-product.blocks.complimentary_products.name"
    }
  ]
}
{% endschema %}