{%- comment -%}
  AYUM copy of Kalles blocks/_product-video.liquid (original left untouched). Used only by
  sections/ayum-product-video.liquid. Every native setting id is kept.

  Section style "ayum" (Figma 2001:366 desktop / 2001:861 mobile) renders the AYUM video card:
  - native <hdt-video-player> WITHOUT autoplay; playback starts from the play button (assets/ayum-shoppable-video.js
    calls the player's own play()/pause()). The `group` attribute is the player's native exclusive-playback hook.
  - duration from Shopify's video object (video.duration is in milliseconds); views = optional merchant label.
  - product panel: real product data, native card-price, native add to cart through snippets/ayum-btn-ultra.liquid.
  Styles 1 and 2 render the native markup unchanged.

  Blank states: no video → Theme Editor placeholder, nothing on the storefront. No product → no product panel.
{%- endcomment -%}
{%- liquid
  assign video = block.settings.video
  assign external = block.settings.external_video_url
  assign product = block.settings.product
  assign has_media = false
  if video != blank or external != blank
    assign has_media = true
  endif
-%}
{%- if section.settings.style == 'ayum' -%}
  {%- if has_media or request.design_mode -%}
    {%- liquid
      assign duration_label = blank
      if video != blank and section.settings.ayum_show_duration and video.duration > 0
        assign total_seconds = video.duration | divided_by: 1000
        assign minutes = total_seconds | divided_by: 60
        assign seconds = total_seconds | modulo: 60
        if seconds < 10
          assign seconds = seconds | prepend: '0'
        endif
        assign duration_label = minutes | append: ':' | append: seconds
      endif
      assign atc_label = section.settings.ayum_atc_label | strip
    -%}
    <div class="hdt-slider__slide ayum-pv__slide" {{ block.shopify_attributes }}>
      <div class="ayum-pv__card">
        {%- comment -%}
          data-controls: Shopify video rendered with the browser's native controls (section setting). The script hides
          them until the first play so the card keeps the Figma look (play circle + badges), then hands over to them.
        {%- endcomment -%}
        <div class="ayum-pv__media"{% if video != blank and section.settings.show_video_controls %} data-controls{% endif %}>
          {%- if video != blank -%}
            <hdt-video-player type="video" group="ayum-pv-{{ section.id }}">
              {{- video | video_tag: image_size: '720x', playsinline: true, muted: section.settings.ayum_video_muted, loop: true, controls: section.settings.show_video_controls, preload: 'metadata' -}}
            </hdt-video-player>
          {%- elsif external != blank -%}
            <hdt-video-player host="{{ external.type }}" type="background" group="ayum-pv-{{ section.id }}">
              <template>
                {%- if external.type == 'youtube' -%}
                  <iframe id="iframe-{{ block.id }}" src="https://www.youtube.com/embed/{{ external.id }}?playsinline=1&autoplay=1&controls=0&mute={% if section.settings.ayum_video_muted %}1{% else %}0{% endif %}&loop=1&playlist={{ external.id }}&enablejsapi=1&rel=0&modestbranding=1&origin={{ 'https://' | append: request.host | url_encode }}" allow="autoplay; encrypted-media" allowfullscreen="allowfullscreen" title="{{ product.title | default: section.settings.ayum_product_label | escape }}"></iframe>
                {%- elsif external.type == 'vimeo' -%}
                  <iframe src="https://player.vimeo.com/video/{{ external.id }}?autoplay=1&autopause=1&background=1&loop=1&muted={% if section.settings.ayum_video_muted %}1{% else %}0{% endif %}&transparent=0&responsive=1&portrait=0&title=0&byline=0" allow="autoplay; encrypted-media;" allowfullscreen="allowfullscreen" title="{{ product.title | default: section.settings.ayum_product_label | escape }}"></iframe>
                {%- endif -%}
              </template>
            </hdt-video-player>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hdt-placeholder-svg ayum-pv__placeholder' }}
          {%- endif -%}

          {%- if block.settings.ayum_poster != blank and has_media -%}
            {{ block.settings.ayum_poster | image_url: width: 900 | image_tag: class: 'ayum-pv__poster', loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 1150px) 260px, (min-width: 768px) 33vw, 50vw', alt: '' }}
          {%- endif -%}

          {%- if has_media -%}
            <button type="button" class="ayum-pv__play" aria-pressed="false" aria-label="{{ 'products.product.media.play_video' | t | escape }}{% if product != blank %}: {{ product.title | escape }}{% endif %}">
              <span class="ayum-pv__play-icon" aria-hidden="true">
                <svg width="60" height="60" viewBox="0 0 60 60" focusable="false"><path class="ayum-pv__icon-play" d="M26.9667 22.8833L38.05 30L26.9667 37.1167V22.8833Z" fill="currentColor" stroke="currentColor" stroke-width="3.03333" stroke-linecap="round" stroke-linejoin="round"/><path class="ayum-pv__icon-pause" d="M25 22v16M35 22v16" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
              </span>
            </button>
          {%- endif -%}

          {%- if block.settings.ayum_views != blank -%}
            <span class="ayum-pv__badge ayum-pv__badge--views">{{ block.settings.ayum_views | escape }}</span>
          {%- endif -%}
          {%- if duration_label != blank -%}
            <span class="ayum-pv__badge ayum-pv__badge--duration">{{ duration_label }}</span>
          {%- endif -%}
        </div>

        {%- if product != blank -%}
          <div class="ayum-pv__panel">
            <div class="ayum-pv__product">
              {%- assign image = product.featured_media -%}
              {%- if image != blank -%}
                <a href="{{ product.url }}" class="ayum-pv__thumb" tabindex="-1" aria-hidden="true">
                  {{ image | image_url: width: 96 | image_tag: loading: 'lazy', width: 48, height: 48, widths: '48,96', sizes: '48px', alt: '' }}
                </a>
              {%- endif -%}
              <div class="ayum-pv__info">
                {%- if section.settings.ayum_product_label != blank -%}
                  <p class="ayum-pv__label">{{ section.settings.ayum_product_label | escape }}</p>
                {%- endif -%}
                <a href="{{ product.url }}" class="ayum-pv__title">{{ product.title | escape }}</a>
                <div class="ayum-pv__price">
                  {%- render 'card-price', product: product, price_class: 'hdt-price-wrapp', show_compare_at_price: true -%}
                </div>
              </div>
            </div>
            <div class="ayum-pv__atc hdt-pr-btns-group1">
              {%- render 'ayum-btn-ultra', class: 'hdt-pr_btn', product: product, product_url: product.url, section_id: section.id, disable_sr_only: true, add_label: atc_label -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- else -%}
<div id="hdt-media-{{ block.id }}" class="hdt-slider__slide md:hdt-height--{{ section.settings.image_height }} hdt-height--{{ section.settings.image_height_mb }} hdt-ratio--adapt_image" {{ block.shopify_attributes }} hdt-reveal="slide-in" timeline>
  {%- style -%}
  #hdt-media-{{ block.id }} {
    {%- if section.settings.image_height == 'fixed' -%}
      --aspect-ratioapt-md: {{ section.settings.fixed_height }}px;
    {%- elsif section.settings.image_height == 'adapt_image_first' and block.settings.video -%}
      --aspect-ratioapt-md: {{ block.settings.video.aspect_ratio }};
    {%- else -%}
      --aspect-ratioapt-md: 1.77777777778;
    {%- endif -%}
    {%- if section.settings.image_height_mb == 'fixed' -%}
      --aspect-ratioapt: {{ section.settings.fixed_height_mb }}px;
    {%- elsif section.settings.image_height_mb == 'adapt_image_first' and block.settings.video -%}
      --aspect-ratioapt: {{ block.settings.video.aspect_ratio }};
    {%- else -%}
      --aspect-ratioapt: 1.77777777778;
    {%- endif -%}
  }
  {%- endstyle -%}
  <div calc-nav class="hdt-media-overlap-content">
    {%- if block.settings.video -%}
      <hdt-video-player autoplay>
        {{- block.settings.video | video_tag: image_size: '1500x', playsinline: true, muted: true, loop: true, controls: false, preload: 'metadata' -}}
      </hdt-video-player>
    {%- else -%}
      <hdt-video-player host="{{ block.settings.external_video_url.type }}" type="background" autoplay>
        <template>
          {%- if block.settings.external_video_url.type == 'youtube' -%}
            <iframe id="iframe-{{ block.id }}" src="https://www.youtube.com/embed/{{ block.settings.external_video_url.id }}?playsinline=1&autoplay=1&controls=0&mute=1&loop=1&playlist={{ block.settings.external_video_url.id }}&enablejsapi=1&rel=0&modestbranding=1&origin={{ 'https://' | append: request.host | url_encode }}" allow="autoplay; encrypted-media" allowfullscreen="allowfullscreen"></iframe>
          {%- elsif block.settings.external_video_url.type == 'vimeo' -%}
            <iframe src="https://player.vimeo.com/video/{{ block.settings.external_video_url.id }}?autoplay=1&autopause=1&background=1&loop=1&muted=1&transparent=0&responsive=1&portrait=0&title=0&byline=0&color={{ settings.color_accent | remove_first: '#' }}" allow="autoplay; encrypted-media;" allowfullscreen="allowfullscreen"></iframe>
          {%- endif -%}
        </template>
      </hdt-video-player>
    {%- endif -%}
  </div>
  <div class="hdt-content">
    {%- liquid
      assign product = block.settings.product
    -%}
    {%- if product != blank -%}
      <div class="hdt-content__item hdt-flex hdt-align-center hdt-justify-center">
        {%- assign image = product.featured_media | default: settings.placeholder_img -%}
        <div class="hdt-content__item--image">
          {%- if image != blank -%}
            <a href="{{ product.url }}" class="hdt-d-block hdt-relative hdt-oh hdt-ratio hdt-radius-full" style="--aspect-ratioapt:{{ image.aspect_ratio | default: 1 }}">
              {{ image | image_url: width: image.width | image_tag: loading: 'lazy', width: image.width, height: image.height, sizes: '(max-width: 767px) 80px, 160px', widths: '80, 160' }}
            </a>
          {%- endif -%}
        </div>
        <div class="hdt-content__item--infos hdt-relative hdt-oh">
          <a href="{{ product.url }}" class="hdt-block hdt-content__item--title hdt-s-text hdt-text-lg hdt-font-normal hdt-truncate">
            {{- product.title -}}
          </a>
          <div class="hdt-content__item--price hdt-s-text hdt-text-base hdt-font-semibold">
            {%- render 'card-price', product: product, price_class: 'hdt-price-wrapp', show_compare_at_price: true -%}
          </div>
        </div>
        <div class="hdt-content__item--quickview">
          {%- if section.settings.style == '1' -%}
            <wrapp-hdt-open-modal-btn class="hdt-contents">
              <button type="button" handle="{{ product.handle }}" aria-controls="hdt-quick-view-modal" aria-expanded="false" class="hdt-card-product__btn-quick-view {{ btn_class }}" {{ attr }} aria-label="{{ 'products.product.quick_view' | t }}">
                <span class="hdt-pr-card-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="hdt-svg-pr-icon hdt-svg-qv" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </span>
                <span {% unless disable_sr_only %}class="sr-only"{% endunless %}>{{ 'products.product.quick_view' | t }}</span>
              </button>
            </wrapp-hdt-open-modal-btn>
          {%- else -%}
            <a href="{{ product.url }}" class="hdt-content__item--quickview-link">
              <svg width="25" height="25" viewBox="0 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M16.1486 15.3255L17.8149 9.10664L11.5961 7.44031" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M6.77326 15.4817L17.7047 9.17041" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      <div class="hdt-content__item hdt-flex hdt-align-center hdt-justify-center">
        <div class="hdt-content__item--image">
          <div
            class="hdt-d-block hdt-relative hdt-oh hdt-ratio hdt-radius-full"
            style="--aspect-ratioapt:0.6666666666666666"
          >
            <div class="hdt-content__item--image-placeholder"></div>
          </div>
        </div>
        <div class="hdt-content__item--infos hdt-relative hdt-oh">
          <h3 class="hdt-block hdt-content__item--title hdt-s-text hdt-text-lg hdt-font-normal hdt-truncate">
            {{ 'onboarding.product_title' | t }}
          </h3>
          <div class="hdt-content__item--price hdt-s-text hdt-text-base hdt-font-semibold">99</div>
          <div class="hdt-content__item--quickview"></div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
  {
    "name": "Item",
    "tag": null,
    "settings": [
      {
        "type": "video",
        "id": "video",
        "label": "t:sections.video.settings.video.label",
        "info": "t:sections.video.settings.video.info"
      },
      {
        "type": "video_url",
        "id": "external_video_url",
        "accept": [
          "vimeo",
          "youtube"
        ],
        "label": "t:sections.video.settings.video.url",
        "info": "Used only when no Shopify video is selected."
      },
      {
        "type": "product",
        "id": "product",
        "label": "Product"
      },
      {
        "type": "header",
        "content": "AYUM video card",
        "info": "Used when the section Style is AYUM."
      },
      {
        "type": "text",
        "id": "ayum_views",
        "label": "Views count badge",
        "placeholder": "124 ألف مشاهدة",
        "info": "Shown at the top-right of this video. Enter this video's real view count; it is not calculated automatically. Leave blank to hide the badge."
      },
      {
        "type": "image_picker",
        "id": "ayum_poster",
        "label": "Custom poster image",
        "info": "Optional. Covers the video until it is played. Without it the video's own preview image is used."
      }
    ],
    "presets": [
      {
        "name": "Item"
      }
    ]
  }
{% endschema %}
