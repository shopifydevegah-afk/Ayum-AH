{%- comment -%}
  AYUM: nutrition table rows (static child of "Nutrition popup"); one "Nutrition row" block per nutrient.
  A product with the multi-line metafield ayum.nutrition_table ("name | per 100 g | per pack" per line) shows
  those rows instead of the row blocks.
{%- endcomment -%}
{%- liquid
  assign target = product
  assign product = section.settings.product | default: target
  assign mf_rows = product.metafields.ayum.nutrition_table.value | strip
-%}
{%- if mf_rows != blank -%}
  {%- assign rows = mf_rows | newline_to_br | split: '<br />' -%}
  {%- for row in rows -%}
    {%- assign cells = row | strip | split: '|' -%}
    {%- if cells.size > 0 and cells[0] != blank -%}
      <tr>
        <th scope="row">{{ cells[0] | strip | escape }}</th>
        <td>{{ cells[1] | strip | escape }}</td>
        <td>{{ cells[2] | strip | escape }}</td>
      </tr>
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- content_for 'blocks' -%}
{%- endif -%}
{% schema %}
{
  "name": "Nutrition rows",
  "tag": null,
  "blocks": [
    {
      "type": "_ayum-nutrition-row"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Add a Nutrition row for each nutrient. Drag rows to reorder them. A product with the metafield ayum.nutrition_table shows those rows instead."
    }
  ]
}
{% endschema %}
