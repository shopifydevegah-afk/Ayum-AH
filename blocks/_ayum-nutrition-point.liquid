{%- comment -%} AYUM: one point under the nutrition table (child of "Nutrition points"). {%- endcomment -%}
{%- if block.settings.title != blank -%}
  <li {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong>{% if block.settings.text != blank %}<span>{{ block.settings.text | escape }}</span>{% endif %}</li>
{%- endif -%}
{% schema %}
{
  "name": "Nutrition point",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Nutrition point"
    }
  ]
}
{% endschema %}
