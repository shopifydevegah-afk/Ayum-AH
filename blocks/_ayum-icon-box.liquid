<!-- blocks/_ayum-icon-box.liquid — AYUM copy of _icon_box.liquid (original left untouched) -->
{%- comment -%}
  AYUM process step (Figma 2001:268 / 2001:784). Native Icon box markup and settings, plus:
  - "Step number", shown before the heading ("1 · Heading").
  - "Mobile description" (below 768px; falls back to "Description" when empty).
  - "AYUM icon" (snippets/ayum-icons.liquid), used when no native image / SVG is set for the
    section's icon source. "Icon background" colours the circle; the icon itself uses the scheme.
  Only available inside sections/ayum-icon-box.liquid. Styled in assets/dev1.css (.ayum-icon-box).
{%- endcomment -%}
{%- liquid
  assign number = block.settings.ayum_number | strip
  assign description = block.settings.description
  assign description_mb = block.settings.ayum_description_mb | strip
-%}
<div class="hdt-iconbox-item ayum-step hdt-relative"{% if block.settings.ayum_icon_bg != blank %} style="--ayum-step-icon-bg: {{ block.settings.ayum_icon_bg.rgb }};"{% endif %} {{ block.shopify_attributes }}>
  <div class="hdt-iconbox-item-wrapper hdt-text-center">
    {% if block.settings.url != blank %}<a class="hdt-full-width-link"  aria-label="link" href="{{ block.settings.url }}"></a>{% endif %}
    <span class="hdt-iconbox-head hdt-flex hdt-align-center hdt-justify-center">
      <div class="hdt-iconbox-icon" aria-hidden="true">
        {%- if block.settings.image != blank and section.settings.source == 'image' -%}
          <span class="hdt-iconbox-icon__image " style="--max-width:{{ block.settings.image.width }}px;--width:{{ block.settings.image_width }}px;">
          {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', width: block.settings.image.width, height: block.settings.image.height, class: '' , sizes: sizes, widths: "24, 52, 48, 104, 120, 240, 360, 480, 600", alt: '' }}
          </span>
        {%- elsif block.settings.svg_upload != blank and section.settings.source == 'svg' -%}
          <span class="hdt-iconbox-icon__svg" style="--w-image-svg:{{ block.settings.svg_width }}px;--w-image-svg-mb:{{ block.settings.svg_width_mb }}px;">
            {{ block.settings.svg_upload }}
          </span>
        {%- elsif block.settings.ayum_icon != 'none' -%}
          <span class="hdt-iconbox-icon__svg" style="--w-image-svg:{{ block.settings.svg_width }}px;--w-image-svg-mb:{{ block.settings.svg_width_mb }}px;">
            {%- render 'ayum-icons', icon: block.settings.ayum_icon -%}
          </span>
        {%- else -%}
          {%- render 'icons', icon: block.settings.icon -%}
        {%- endif -%}
      </div>
      {%- if block.settings.heading != blank or number != blank -%}
        <h5 class="hdt-iconbox-heading {% if block.settings.icon_position == 'right' %} hdt-order-first{% endif %}">
          {%- if number != blank -%}<span class="ayum-step__number" dir="auto">{{ number | escape }}</span> · {% endif -%}
          {{ block.settings.heading }}
        </h5>
      {%- endif -%}
    </span>
    {% if description != blank or description_mb != blank %}
      <div class="hdt-iconbox-des">
        {%- if description != blank and description_mb != blank -%}
          <span class="ayum-step__desc ayum-step__desc--desktop">{{ description }}</span>
          <span class="ayum-step__desc ayum-step__desc--mobile">{{ description_mb | escape }}</span>
        {%- else -%}
          {{ description | default: description_mb }}
        {%- endif -%}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
  {
    "name": "Icon box",
    "class": "hdt-slider__slide",
    "settings": [
      {
        "type": "url",
        "id": "url",
        "label": "Link to"
      },
      {
        "type": "checkbox",
        "id": "open_in_new_tab",
        "label": "Open in new tab",
        "default": false
      },
      {
        "type": "select",
        "id": "icon_position",
        "label": "Icon position",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left"
      },
      {
        "type": "header",
        "content": "Icon settings"
      },
      {
        "type": "select",
        "id": "ayum_icon",
        "label": "AYUM icon",
        "info": "Used when no image or SVG is set below.",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "snowflake",
            "label": "Snowflake"
          },
          {
            "value": "drop",
            "label": "Water drop"
          },
          {
            "value": "jar",
            "label": "Sealed pack"
          },
          {
            "value": "factory",
            "label": "Factory"
          },
          {
            "value": "noheat",
            "label": "No heat"
          },
          {
            "value": "shield",
            "label": "Shield"
          },
          {
            "value": "truck",
            "label": "Delivery truck"
          }
        ],
        "default": "snowflake"
      },
      {
        "type": "color",
        "id": "ayum_icon_bg",
        "label": "Icon background",
        "default": "#EA3A79"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image",
        "visible_if": "{{ section.settings.source == 'image' }}"
      },
      {
        "type": "number",
        "id": "image_width",
        "label": "Image width (Unit: px)",
        "default": 50,
        "info": "Set 0 to use width default",
        "visible_if": "{{ section.settings.source == 'image' }}"
      },
      {
        "type": "liquid",
        "id": "svg_upload",
        "label": "Svg",
        "visible_if": "{{ section.settings.source == 'svg' }}"
      },
      {
        "type": "paragraph",
        "content": "t:blocks.icon.custom_svg_icon.content",
        "visible_if": "{{ section.settings.source == 'svg' }}"
      },
      {
        "type": "range",
        "id": "svg_width",
        "min": 16,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Svg width",
        "default": 30
      },
      {
        "type": "range",
        "id": "svg_width_mb",
        "min": 16,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Svg width (Mobile)",
        "default": 22
      },
      {
        "type": "header",
        "content": "Content settings"
      },
      {
        "type": "text",
        "id": "ayum_number",
        "label": "Step number",
        "info": "Optional. Shown before the heading.",
        "default": "1"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Heading"
      },
      {
        "type": "text",
        "id": "description",
        "label": "Description",
        "default": "Description"
      },
      {
        "type": "text",
        "id": "ayum_description_mb",
        "label": "Mobile description",
        "info": "Optional. Shown below 768px instead of the description. Leave empty to use the description on mobile."
      }
    ],
    "presets": [
      {
        "name": "Icon box"
      }
    ]
  }
{% endschema %}
